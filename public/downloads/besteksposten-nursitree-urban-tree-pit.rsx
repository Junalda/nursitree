                  <hoofdcode.vastetekst>Grondsoorten gescheiden ontgraven </hoofdcode.vastetekst>
                  <hoofdcode.vrijetekst>.....</hoofdcode.vrijetekst>
                </alinea.hoofdcode>
                <aanwijzings.tekst>Grondsoorten en laagdiktes en eventuele bijzonderheden vermelden.</aanwijzings.tekst>
              </deficode.inhoud.tekst>
            </deficode>
            <deficode>
              <positie.nr>2</positie.nr>
              <inhoud.nr>1</inhoud.nr>
              <deficode.inhoud.tekst>
                <alinea.hoofdcode>
                  <hoofdcode.vastetekst>Ontgravingshoogte gemiddeld </hoofdcode.vastetekst>
                  <hoofdcode.invultekst lengte="20">#!</hoofdcode.invultekst>
                  <hoofdcode.vastetekst> m </hoofdcode.vastetekst>
                </alinea.hoofdcode>
                <aanwijzings.tekst>Eventueel bijzonderheden vermelden of verwijzen naar tekening, bij grote variatie in ontgravingshoogte deficode 2 toepassen of extra besteksposten toevoegen.</aanwijzings.tekst>
              </deficode.inhoud.tekst>
