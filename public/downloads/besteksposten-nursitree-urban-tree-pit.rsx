  <dl1.compleet uitbreiden="ja" tabposities="L65;L145">
    <dlx.koptekst>NursiTree<br />Besteksposten leveren en aanbrengen Urban Tree Pit</dlx.koptekst>
    <dlx.deel.naam>1. Algemeen</dlx.deel.naam>
    <dlx.paragraaf verwijderen="nee" tabposities="L65;L145">
      <dlx.paragraafnummer muteren="nee">01</dlx.paragraafnummer>
      <dlx.paragraafnaam muteren="nee">Opdrachtgever</dlx.paragraafnaam>
      <dlx.paragraaftekst muteren="ja">
        <alinea.paragraaf>..............................................................</alinea.paragraaf>
        <aanwijzings.tekst>Zie ook algemene gedeelte (hoofdstuk 00) van de handleiding.<br /></aanwijzings.tekst>
      </dlx.paragraaftekst>
    </dlx.paragraaf>
    <dlx.paragraaf verwijderen="nee" tabposities="L65;L145">
      <dlx.paragraafnummer muteren="nee">02</dlx.paragraafnummer>
