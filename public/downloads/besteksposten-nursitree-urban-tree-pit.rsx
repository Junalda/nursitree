                  <hoofdcode.vrijetekst>420790</hoofdcode.vrijetekst>
                </alinea.hoofdcode>
              </deficode.inhoud.tekst>
            </deficode>
            <deficode>
              <positie.nr>5</positie.nr>
              <inhoud.nr>1</inhoud.nr>
              <deficode.inhoud.tekst>
                <alinea.hoofdcode>
