            <dl22.bpost.nr6.0>420770</dl22.bpost.nr6.0>
            <romptekst>Leveren en verwerken zand rondom Urban Tree Pit.</romptekst>
            <dl22.eenheid.res.verpl.ro eenheidwijzigbaar="nee">m3</dl22.eenheid.res.verpl.ro>
            <dl22.hoev.res.verpl.ro kenmerk="F">10.9</dl22.hoev.res.verpl.ro>
            <dl22.hoofdcode>
              <werkcategorie.nr>22</werkcategorie.nr>
              <subwerkcategorie.nr>03</subwerkcategorie.nr>
              <hoofdcode.volgnr>01</hoofdcode.volgnr>
            </dl22.hoofdcode>
            <versie.informatie>
              <versie.id>6182edf9-180a-445f-8e8b-bbcc4e9ef0cd</versie.id>
              <versie.nummer>3</versie.nummer>
              <versie.datum>2025-09-30</versie.datum>
              <versie.status>verplicht</versie.status>
              <versie.jaarversie>2025-09</versie.jaarversie>
              <versie.release>2026-01</versie.release>
              <versie.kenmerk.vervang>
                <verwijzing.catalogus wcat="22" subwcat="03" vlgnr="01">
                </verwijzing.catalogus>
                <versie.datum.verwijzing>2025-09</versie.datum.verwijzing>
              </versie.kenmerk.vervang>
              <versie.laatste.mutatie>2025-04-29</versie.laatste.mutatie>
            </versie.informatie>
            <hoofdcode.hoofdtekst>
              <hoofdcode.titel.vastetekst>Grond verwerken in </hoofdcode.titel.vastetekst>
              <hoofdcode.titel.vrijetekst>cunet rondom Urban Tree Pit.</hoofdcode.titel.vrijetekst>
              <aanwijzings.tekst>(Invullen: grondlichaam, of depot, of terrein, of anders)</aanwijzings.tekst>
            </hoofdcode.hoofdtekst>
            <hoofdcode.tekstblok>
              <alinea.hoofdcode>
                <hoofdcode.vrijetekst>Betreft het aanvullen met grond vrijgekomen van bestekspost: 420610. </hoofdcode.vrijetekst>
              </alinea.hoofdcode>
              <alinea.hoofdcode>
                <hoofdcode.vrijetekst>ca. 10,9 m3 per Urban Tree Pit</hoofdcode.vrijetekst>
              </alinea.hoofdcode>
              <aanwijzings.tekst>Situering in het werk (met vermelding van tek.nrs.) en bijzonderheden volgens handleiding vermelden.</aanwijzings.tekst>
            </hoofdcode.tekstblok>
            <hoofdcode.tekstblok>
              <alinea.hoofdcode eenheid.bouwstof="m3" eenheidwijzigbaar="ja" hoev.bouwstof="10.9" aard="L">
                <hoofdcode.vastetekst>Grondsoort:</hoofdcode.vastetekst>
                <hoofdcode.vrijetekst> #!.</hoofdcode.vrijetekst>
              </alinea.hoofdcode>
              <aanwijzings.tekst>Voor het aangeven van de grondsoorten wordt verwezen naar de handleiding. Voor zover de grond wordt geleverd tevens van de te leveren grond de kwaliteitsklasse volgens het Besluit bodemkwaliteit vermelden. Eventueel aanvullende gegevens opnemen in een bijlage bij het bestek.</aanwijzings.tekst>
            </hoofdcode.tekstblok>
            <deficode>
              <positie.nr>1</positie.nr>
              <inhoud.nr>1</inhoud.nr>
              <deficode.inhoud.tekst>
                <alinea.hoofdcode>
                  <hoofdcode.vastetekst>Gemiddelde hoogte </hoofdcode.vastetekst>
                  <hoofdcode.invultekst lengte="20">#!</hoofdcode.invultekst>
                  <hoofdcode.vastetekst> m </hoofdcode.vastetekst>
                </alinea.hoofdcode>
                <aanwijzings.tekst>Bij grote variatie in hoogte deficodes 5 t/m 8 toepassen of extra besteksposten toevoegen.</aanwijzings.tekst>
              </deficode.inhoud.tekst>
            </deficode>
            <deficode>
              <positie.nr>2</positie.nr>
              <inhoud.nr>4</inhoud.nr>
              <deficode.inhoud.tekst>
                <alinea.hoofdcode>
                  <hoofdcode.vastetekst>Bovenoppervlakte </hoofdcode.vastetekst>
                  <hoofdcode.invultekst lengte="20">#!</hoofdcode.invultekst>
                  <hoofdcode.vastetekst> m2 </hoofdcode.vastetekst>
                </alinea.hoofdcode>
              </deficode.inhoud.tekst>
            </deficode>
            <deficode>
              <positie.nr>4</positie.nr>
              <inhoud.nr>6</inhoud.nr>
              <deficode.inhoud.tekst>
                <alinea.hoofdcode>
